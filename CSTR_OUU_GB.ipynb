    "\n",
    "# ==========================================\n",
    "# TASK 3: SEQUENTIAL OPT (PIECEWISE)\n",
    "# ==========================================\n",
    "def run_task3():\n",
    "    print(\"\\n--- TASK 3: Sequential Opt (Piecewise, Chance-Constrained) ---\")\n",
    "    def obj(u):\n",
    "        _, _, cA_int = simulate_scenarios(u, steps=6)\n",
    "        return -np.mean(cA_int)\n",
    "    def chance_con(u):\n",
    "        t_eval, Y_all, _ = simulate_scenarios(u, steps=6)\n",
    "        T_mean = Y_all[:, 3, :].mean(axis=0)\n",
    "        T_std = Y_all[:, 3, :].std(axis=0)\n",
    "        return 350.0 - np.max(T_mean + Z_95 * T_std)\n",
    "\n",
    "    bounds = [((max(u_min, 333 - du_max), min(u_max, 333 + du_max)) if i==0 else (u_min, u_max)) for i in range(6) for _ in range(2)]\n",
    "    \n",
    "    A_diff = np.zeros((10, 12))\n",
    "    for i in range(1, 6):\n",
    "        A_diff[2 * (i - 1), 2 * i] = 1.0; A_diff[2 * (i - 1), 2 * (i - 1)] = -1.0\n",
    "        A_diff[2 * (i - 1) + 1, 2 * i + 1] = 1.0; A_diff[2 * (i - 1) + 1, 2 * (i - 1) + 1] = -1.0\n",
    "\n",
    "    res = minimize(obj, [333.0] * 12, bounds=bounds, \n",
    "                   constraints=[LinearConstraint(A_diff, -du_max, du_max), NonlinearConstraint(chance_con, 0.0, np.inf)], \n",
    "                   method='SLSQP')\n",
    "\n",
    "    t_eval, Y_all, cA_int = simulate_scenarios(res.x, steps=6)\n",
    "    chance_bound = Y_all[:, 3, :].mean(axis=0) + Z_95 * Y_all[:, 3, :].std(axis=0)\n",
    "    t_u = np.arange(0, horizon + 1, dt_control)\n",
    "    plot_scenario_results('Task 3: Sequential Piecewise', t_eval, Y_all, t_u, \n",
    "                          [res.x[2*i] for i in range(6)] + [res.x[-2]], \n",
    "                          [res.x[2*i+1] for i in range(6)] + [res.x[-1]], chance_bound)\n",
    "    return res.x\n",
    "\n"
   ]
