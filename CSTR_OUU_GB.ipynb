   "source": [
    "We perform a stochastic simulation to rigorously account for real-world physical uncertainties, ensuring the control strategy safely respects thermal constraints even under worst-case parameter variations. Coupling this with sensitivity analysis allows us to pinpoint exactly which variables drive the most risk and performance variance, guiding a more robust and targeted optimization approach.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e5d369f2",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# ==========================================\n",
    "# TASK 1: STOCHASTIC SIMULATION\n",
    "# ==========================================\n",
    "def run_task1():\n",
    "    print(\"\\n--- TASK 1: Stochastic Simulation & Sensitivity ---\")\n",
    "    t_eval = np.linspace(0, horizon, 300)\n",
    "    Y_all = np.zeros((N_SCENARIOS, 4, len(t_eval)))\n",
    "\n",
    "    for i in range(N_SCENARIOS):\n",
    "        sol = solve_ivp(cstr_ode, [0, horizon], x0, args=(333.0, 333.0, epsilons[i]),\n",
    "                         method='BDF', t_eval=t_eval)\n",
    "        Y_all[i] = sol.y\n",
    "\n",
    "    fig, axs = plt.subplots(2, 2, figsize=(12, 8))\n",
    "    fig.suptitle('Task 1: CSTR Stochastic Sensitivity Analysis')\n",
    "\n",
    "    for idx, ax in enumerate(axs.flat):\n",
    "        for i in range(N_SCENARIOS):\n",
    "            ax.plot(t_eval, Y_all[i, idx, :], color=STATE_COLORS[idx], alpha=0.15)\n",
    "        ax.plot(t_eval, Y_all[:, idx, :].mean(axis=0), color=STATE_COLORS[idx],\n",
    "                 linewidth=2, label='Mean')\n",
    "        ax.set_title(STATE_LABELS[idx])\n",
    "        ax.set_xlabel('Time [s]')\n",
    "        ax.grid(True, linestyle='--', alpha=0.6)\n",
    "        if idx == 3:\n",
    "            ax.axhline(350, color='k', linestyle=':', label='Max T (350K)')\n",
    "        ax.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# ==========================================\n",
    "# TASK 2: SEQUENTIAL OPT (CONSTANT)\n",
    "# ==========================================\n",
    "def run_task2():\n",
    "    print(\"\\n--- TASK 2: Sequential Opt (Constant, Chance-Constrained) ---\")\n",
    "    def obj(u):\n",
    "        _, _, cA_int = simulate_scenarios(u, steps=1)\n",
    "        return -np.mean(cA_int)\n",
    "    def chance_con(u):\n",
    "        t_eval, Y_all, _ = simulate_scenarios(u, steps=1)\n",
    "        T_mean = Y_all[:, 3, :].mean(axis=0)\n",
    "        T_std = Y_all[:, 3, :].std(axis=0)\n",
    "        return 350.0 - np.max(T_mean + Z_95 * T_std)\n",
    "\n",
    "    bounds = [(u_min, u_max), (u_min, u_max)]\n",
    "    nlc = NonlinearConstraint(chance_con, 0.0, np.inf)\n",
    "    res = minimize(obj, [333.0, 333.0], bounds=bounds, constraints=[nlc], method='SLSQP')\n",
    "\n",
    "    t_eval, Y_all, cA_int = simulate_scenarios(res.x, steps=1)\n",
    "    chance_bound = Y_all[:, 3, :].mean(axis=0) + Z_95 * Y_all[:, 3, :].std(axis=0)\n",
    "    \n",
    "    plot_scenario_results('Task 2: Sequential Constant', t_eval, Y_all, [0, horizon], \n",
    "                          [res.x[0], res.x[0]], [res.x[1], res.x[1]], chance_bound)\n",
    "    return res.x\n"
   ]
  },
