    "# ==========================================\n",
    "# TASKS 4, 5, 6: SIMULTANEOUS OPTIMIZATION (OCFE)\n",
    "# ==========================================\n",
    "def build_casadi_scenario_ode(eps_vals):\n",
    "    x = ca.MX.sym('x', 5); u = ca.MX.sym('u', 2)\n",
    "    cA, cB, cC, T, q = x[0], x[1], x[2], x[3], x[4]; Tj, T0 = u[0], u[1]\n",
    "    e1, e2, e3, e4 = eps_vals\n",
    "    kA = kA0 * e1 * ca.exp(-EA / (R * T))\n",
    "    kB = kB0 * e2 * ca.exp(-EB / (R * T))\n",
    "\n",
    "    dcA = (F / V) * (cA0_feed - cA) - kA * cA + kB * cB\n",
    "    dcB = (F / V) * (cB0_feed - cB) - kB * cB\n",
    "    dcC = (F / V) * (cC0_feed - cC) + kA * cA\n",
    "    dT = (F / V) * (T0 - T) + (UA / (rho * e3 * cp * e4 * V)) * (Tj - T) \\\n",
    "         + (-dHA / (rho * e3 * cp * e4)) * kA * cA + (-dHB / (rho * e3 * cp * e4)) * kB * cB\n",
    "\n",
    "    return ca.Function('f_ode', [x, u], [ca.vertcat(dcA, dcB, dcC, dT, cA)])\n",
    "\n",
    "def run_simultaneous_tasks(constant_control=True):\n",
    "    \n",
    "    task_num = 5 if constant_control else 6\n",
    "    print(f\"\\n--- TASK {task_num}: Simultaneous Opt (OCFE, Chance-Constrained) ---\")\n",
    "\n",
    "    N_intervals = 1 if constant_control else 6\n",
    "    h, d = horizon / N_intervals, 3\n",
    "    tau = np.append(0, ca.collocation_points(d, 'radau'))\n",
    "    C, D = np.zeros((d + 1, d + 1)), np.zeros(d + 1)\n",
    "    \n",
    "    for j in range(d + 1):\n",
    "        p = np.poly1d([1])\n",
    "        for r in range(d + 1):\n",
    "            if r != j: p = np.poly1d([1, -tau[r]]) * p / (tau[j] - tau[r])\n",
    "        D[j] = p(1.0)\n",
    "        pder = p.deriv()\n",
    "        for r in range(d + 1): C[j, r] = pder(tau[r])\n",
    "\n",
    "    f_scenarios = [build_casadi_scenario_ode(epsilons[i]) for i in range(N_SCENARIOS)]\n",
    "    w, w0, lbw, ubw, g, lbg, ubg = [], [], [], [], [], [], []\n",
    "    J = 0\n",
    "    U = []\n",
    "    \n",
    "    for k in range(N_intervals):\n",
    "        Uk = ca.MX.sym(f'U_{k}', 2)\n",
    "        U.append(Uk); w.append(Uk); w0 += [333, 333]\n",
    "        lbw += [u_min, u_min]; ubw += [u_max, u_max]\n",
    "        if k == 0: g.append(Uk - 333.0); lbg += [-du_max, -du_max]; ubg += [du_max, du_max]\n",
    "        elif not constant_control: g.append(Uk - U[k - 1]); lbg += [-du_max, -du_max]; ubg += [du_max, du_max]\n",
    "\n",
    "    T_ends, q_finals, x0_full = [[] for _ in range(N_intervals)], [], x0 + [0.0]\n",
    "\n",
    "    for s in range(N_SCENARIOS):\n",
    "        Xk = ca.MX.sym(f'X_{s}_0', 5)\n",
    "        w.append(Xk); lbw += x0_full; ubw += x0_full; w0 += x0_full\n",
    "        for k in range(N_intervals):\n",
    "            X_col = []\n",
    "            for j in range(1, d + 1):\n",
    "                Xj = ca.MX.sym(f'X_{s}_{k}_{j}', 5)\n",
    "                w.append(Xj); lbw += [0,0,0,200,0]; ubw += [100,100,100,400,ca.inf]; w0 += x0_full\n",
    "                X_col.append(Xj)\n",
    "            X_next = ca.MX.sym(f'X_{s}_{k + 1}', 5)\n",
    "            w.append(X_next); lbw += [0,0,0,200,0]; ubw += [100,100,100,400,ca.inf]; w0 += x0_full\n",
    "            T_ends[k].append(X_next[3])\n",
    "            \n",
    "            for j in range(1, d + 1):\n",
    "                dx = C[0, j] * Xk + sum(C[r, j] * X_col[r - 1] for r in range(1, d + 1))\n",
    "                g.append(h * f_scenarios[s](X_col[j - 1], U[k]) - dx)\n",
    "                lbg += [0]*5; ubg += [0]*5\n",
    "                \n",
    "            xf = D[0] * Xk + sum(D[r] * X_col[r - 1] for r in range(1, d + 1))\n",
    "            g.append(X_next - xf); lbg += [0]*5; ubg += [0]*5\n",
    "            Xk = X_next\n",
    "        q_finals.append(Xk[4])\n",
    "\n",
    "    J = -sum(q_finals) / N_SCENARIOS\n",
    "    for k in range(N_intervals):\n",
    "        T_k = ca.vertcat(*T_ends[k])\n",
    "        mu_T, var_T = ca.sum1(T_k) / N_SCENARIOS, ca.sum1((T_k - ca.sum1(T_k) / N_SCENARIOS) ** 2) / N_SCENARIOS\n",
    "        g.append(mu_T + Z_95 * ca.sqrt(var_T + 1e-6)); lbg.append(0.0); ubg.append(350.0)\n",
    "\n",
    "    solver = ca.nlpsol('solver', 'ipopt', {'x': ca.vertcat(*w), 'f': J, 'g': ca.vertcat(*g)}, \n",
    "                       {'ipopt.print_level': 0, 'print_time': False, 'ipopt.max_iter': 25000})\n",
    "    sol = solver(x0=ca.vertcat(*w0), lbx=ca.vertcat(*lbw), ubx=ca.vertcat(*ubw), lbg=ca.vertcat(*lbg), ubg=ca.vertcat(*ubg))\n",
    "\n",
    "    u_opt = sol['x'].full().flatten()[:2 * N_intervals].reshape(N_intervals, 2)\n",
    "    u_traj = (list(u_opt[0])*6) if constant_control else u_opt.flatten().tolist()\n",
    "    \n",
    "    t_eval, Y_all, _ = simulate_scenarios(u_traj, steps=6 if not constant_control else 1)\n",
    "    chance_bound = Y_all[:, 3, :].mean(axis=0) + Z_95 * Y_all[:, 3, :].std(axis=0)\n",
    "    \n",
    "    t_u = [0, horizon] if constant_control else np.arange(0, horizon + 1, dt_control)\n",
    "    Tj_step = [u_opt[0, 0]]*2 if constant_control else list(u_opt[:, 0]) + [u_opt[-1, 0]]\n",
    "    T0_step = [u_opt[0, 1]]*2 if constant_control else list(u_opt[:, 1]) + [u_opt[-1, 1]]\n",
    "    \n",
    "    plot_scenario_results(f'Task {task_num}: Simultaneous', t_eval, Y_all, t_u, Tj_step, T0_step, chance_bound)\n",
    "    return u_traj\n",
    "\n",
    "    \n"
   ]
