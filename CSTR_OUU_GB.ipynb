    "# ===================================================\n",
    "# COMPARATIVE PLOTS FOR UNCERTAINTIES AND MAIN RUN\n",
    "# ===================================================\n",
    "def generate_comparative_plots(u2, u3, u6):\n",
    "    global epsilons\n",
    "    print(\"\\n--- GENERATING COMPARATIVE ANALYSIS PLOTS ---\")\n",
    "    \n",
    "    # Simulate data for all tasks\n",
    "    t_eval, Y_all_2, cA_int_2 = simulate_scenarios(u2, steps=1)\n",
    "    _, Y_all_3, cA_int_3 = simulate_scenarios(u3, steps=6)\n",
    "    t_eval_6, Y_all_6, cA_int_6 = simulate_scenarios(u6, steps=6)\n",
    "\n",
    "    # ==========================================\n",
    "    # TASK 6: INDIVIDUAL 6-PANEL PLOT\n",
    "    # ==========================================\n",
    "    chance_bound_6 = Y_all_6[:, 3, :].mean(axis=0) + Z_95 * Y_all_6[:, 3, :].std(axis=0)\n",
    "\n",
    "    # Format the step controls for plotting\n",
    "    u_opt_reshaped = np.array(u6).reshape(6, 2)\n",
    "    t_u_6 = np.arange(0, horizon + 1, dt_control)\n",
    "    Tj_step_6 = list(u_opt_reshaped[:, 0]) + [u_opt_reshaped[-1, 0]]\n",
    "    T0_step_6 = list(u_opt_reshaped[:, 1]) + [u_opt_reshaped[-1, 1]]\n",
    "\n",
    "    # Generate the 6-panel figure\n",
    "    plot_scenario_results('Task 6: Simultaneous Piecewise (CasADi)', \n",
    "                          t_eval_6, Y_all_6, t_u_6, Tj_step_6, T0_step_6, chance_bound_6)\n",
    "\n",
    "    # ==========================================\n",
    "    # 1. TORNADO PLOTS (1x3)\n",
    "    # ==========================================\n",
    "    def calc_bounds(u, steps):\n",
    "        global epsilons\n",
    "        base = -np.mean(simulate_scenarios(u, steps)[2])\n",
    "        orig = epsilons.copy()\n",
    "        lb, hb = [], []\n",
    "        for i in range(4):\n",
    "            for sign, blist in zip([-1, 1], [lb, hb]):\n",
    "                epsilons = np.ones((N_SCENARIOS, 4))\n",
    "                epsilons[:, i] = 1.0 + (sign * STD_DEV)\n",
    "                blist.append(-np.mean(simulate_scenarios(u, steps)[2]) - base)\n",
    "        epsilons = orig\n",
    "        return lb, hb\n",
    "\n",
    "    bounds = [calc_bounds(u2, 1), calc_bounds(u3, 6), calc_bounds(u6, 6)]\n",
    "    titles = ['Task 2 (Constant)', 'Task 3 (Piecewise)', 'Task 6 (CasADi)']\n",
    "    \n",
    "    fig, axs = plt.subplots(1, 3, figsize=(15, 4), sharey=True)\n",
    "    for i, (ax, (lb, hb), title) in enumerate(zip(axs, bounds, titles)):\n",
    "        y_pos = np.arange(4)\n",
    "        ax.barh(y_pos, lb, color='crimson', label='-5% Var')\n",
    "        ax.barh(y_pos, hb, color='mediumseagreen', label='+5% Var')\n",
    "        if i == 0: \n",
    "            ax.set_yticks(y_pos)\n",
    "            ax.set_yticklabels(['kA0', 'kB0', 'rho', 'cp'])\n",
    "        ax.axvline(0, color='black', linewidth=1)\n",
    "        ax.set_title(title)\n",
    "        ax.set_xlabel('Impact on Objective')\n",
    "    axs[0].legend()\n",
    "    plt.suptitle('Tornado Diagrams: Parameter Sensitivity by Strategy', y=1.05)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # ==========================================\n",
    "    # 2. FAN CHARTS (1x3)\n",
    "    # ==========================================\n",
    "    fig, axs = plt.subplots(1, 3, figsize=(18, 5), sharey=True)\n",
    "    datasets = zip(axs, titles, [Y_all_2, Y_all_3, Y_all_6])\n",
    "    for ax, title, Y in datasets:\n",
    "        perc = np.percentile(Y[:, 3, :], [5, 25, 50, 75, 95], axis=0)\n",
    "        ax.fill_between(t_eval, perc[0], perc[4], color='blue', alpha=0.15, label='5-95%')\n",
    "        ax.fill_between(t_eval, perc[1], perc[3], color='blue', alpha=0.35, label='25-75%')\n",
    "        ax.plot(t_eval, perc[2], 'darkblue', lw=2, label='Median')\n",
    "        ax.axhline(350, color='red', ls='--', lw=1.5, label='Max T Limit')\n",
    "        ax.set_title(title)\n",
    "        ax.set_xlabel('Time [s]')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "    axs[0].set_ylabel('Temperature [K]')\n",
    "    axs[0].legend()\n",
    "    plt.suptitle('Fan Charts: Temperature Probabilities', y=1.05)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # ==========================================\n",
    "    # 3. BOX PLOTS\n",
    "    # ==========================================\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    plt.boxplot([cA_int_2, cA_int_3, cA_int_6], patch_artist=True, labels=titles,\n",
    "                boxprops=dict(facecolor='lightblue', color='black'),\n",
    "                medianprops=dict(color='red', linewidth=2))\n",
    "    plt.ylabel('Integral of cA (Objective Value)')\n",
    "    plt.title('Boxplot: Objective Distribution Across Strategies')\n",
    "    plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# MAIN EXECUTION\n",
    "# ==========================================\n",
    "if __name__ == '__main__':\n",
    "    run_task1()\n",
    "    u2 = run_task2()\n",
    "    u3 = run_task3()\n",
    "    run_simultaneous_tasks(constant_control=True)        # Task 5\n",
    "    u6 = run_simultaneous_tasks(constant_control=False)  # Task 6\n",
    "    generate_comparative_plots(u2, u3, u6)"
   ]
  },
