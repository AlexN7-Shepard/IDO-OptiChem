    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.integrate import solve_ivp\n",
    "from scipy.optimize import minimize, LinearConstraint, NonlinearConstraint\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# CSTR SYSTEM PARAMETERS\n",
    "# ==========================================\n",
    "EA = 69000.0      \n",
    "EB = 72000.0      \n",
    "kA0 = 5.0e6       \n",
    "kB0 = 1.0e7       \n",
    "rho = 800.0       \n",
    "cp = 3.5          \n",
    "UA = 1.4          \n",
    "dHA = 45000.0     \n",
    "dHB = -55000.0    \n",
    "F = 6.5e-4        \n",
    "V = 1.0           \n",
    "R = 8.314         \n",
    "\n",
    "cA0_feed = 5.0\n",
    "cB0_feed = 15.0\n",
    "cC0_feed = 0.0\n",
    "\n",
    "x0 = [8.0, 20.0, 0.0, 333.0]  \n",
    "\n",
    "T_max = 350.0\n",
    "u_min, u_max = 273.0, 373.0\n",
    "du_max = 5.0\n",
    "horizon = 3600.0\n",
    "dt_control = 600.0\n",
    "\n",
    "# ==========================================\n",
    "# UNCERTAINTY SETUP\n",
    "# ==========================================\n",
    "\n",
    "# yes you can remove the random see by putting it in a # \n",
    "np.random.seed(42)\n",
    "N_SCENARIOS = 10 # more scenario = more expensive, normally it should be 100 to validate the model \n",
    "STD_DEV = 0.05 #95% \n",
    "epsilons = np.random.normal(loc=1.0, scale=STD_DEV, size=(N_SCENARIOS, 4))\n",
    "Z_95 = 1.645  \n",
    "\n",
    "STATE_LABELS = ['cA [mol/m³]', 'cB [mol/m³]', 'cC [mol/m³]', 'Temperature T [K]']\n",
    "STATE_COLORS = ['b', 'g', 'm', 'r']\n",
    "\n",
    "# ==========================================\n",
    "# 1. ODE MODEL (WITH UNCERTAINTY)\n",
    "# ==========================================\n",
    "def cstr_ode(t, x, Tj, T0, eps):\n",
    "    cA, cB, cC, T = x\n",
    "    e1, e2, e3, e4 = eps\n",
    "\n",
    "    kA0_s = kA0 * e1\n",
    "    kB0_s = kB0 * e2\n",
    "    rho_s = rho * e3\n",
    "    cp_s = cp * e4\n",
    "\n",
    "    T_safe = np.clip(T, 200.0, 500.0)\n",
    "    kA = kA0_s * np.exp(-EA / (R * T_safe))\n",
    "    kB = kB0_s * np.exp(-EB / (R * T_safe))\n",
    "\n",
    "    dcA = (F / V) * (cA0_feed - cA) - kA * cA + kB * cB\n",
    "    dcB = (F / V) * (cB0_feed - cB) - kB * cB\n",
    "    dcC = (F / V) * (cC0_feed - cC) + kA * cA\n",
    "\n",
    "    dT = (F / V) * (T0 - T) + (UA / (rho_s * cp_s * V)) * (Tj - T) \\\n",
    "         + (-dHA / (rho_s * cp_s)) * kA * cA \\\n",
    "         + (-dHB / (rho_s * cp_s)) * kB * cB\n",
    "\n",
    "    return [dcA, dcB, dcC, dT]\n",
    "\n",
    "# ==========================================\n",
    "# SHARED HELPERS\n",
    "# ==========================================\n",
    "def simulate_scenarios(u_array, steps):\n",
    "    dt = horizon / steps\n",
    "    t_eval = np.linspace(0, horizon, 200)\n",
    "    Y_all = np.zeros((N_SCENARIOS, 4, len(t_eval)))\n",
    "    cA_integral = np.zeros(N_SCENARIOS)\n",
    "\n",
    "    for i in range(N_SCENARIOS):\n",
    "        eps = epsilons[i]\n",
    "        x_curr = np.array(x0)\n",
    "        t_pieces, y_pieces = [], []\n",
    "\n",
    "        for k in range(steps):\n",
    "            Tj, T0 = u_array[2 * k], u_array[2 * k + 1]\n",
    "            t_span = [k * dt, (k + 1) * dt]\n",
    "            sol = solve_ivp(cstr_ode, t_span, x_curr, args=(Tj, T0, eps),\n",
    "                             method='BDF', rtol=1e-3, atol=1e-6)\n",
    "            x_curr = sol.y[:, -1]\n",
    "            t_pieces.append(sol.t)\n",
    "            y_pieces.append(sol.y)\n",
    "\n",
    "        t_cat = np.concatenate(t_pieces)\n",
    "        y_cat = np.concatenate(y_pieces, axis=1)\n",
    "\n",
    "        for s in range(4):\n",
    "            Y_all[i, s, :] = np.interp(t_eval, t_cat, y_cat[s])\n",
    "        cA_integral[i] = np.trapezoid(y_cat[0], t_cat)\n",
    "\n",
    "    return t_eval, Y_all, cA_integral\n",
    "\n",
    "def plot_scenario_results(title, t_eval, Y_all, t_u, Tj_traj, T0_traj, chance_bound=None):\n",
    "    fig, axs = plt.subplots(3, 2, figsize=(12, 10))\n",
    "    fig.suptitle(title)\n",
    "\n",
    "    positions = [(0, 0), (0, 1), (1, 0), (1, 1)]\n",
    "    for idx, (r, c) in enumerate(positions):\n",
    "        ax = axs[r, c]\n",
    "        for i in range(N_SCENARIOS):\n",
    "            ax.plot(t_eval, Y_all[i, idx, :], color=STATE_COLORS[idx], alpha=0.15)\n",
    "        ax.plot(t_eval, Y_all[:, idx, :].mean(axis=0), color=STATE_COLORS[idx],\n",
    "                 linewidth=2, label='Mean')\n",
    "        ax.set_title(STATE_LABELS[idx])\n",
    "        ax.grid(True, alpha=0.5)\n",
    "        ax.set_xlabel('Time [s]')\n",
    "        if idx == 3:\n",
    "            ax.axhline(350, color='k', linestyle=':', label='Max T (350K)')\n",
    "            if chance_bound is not None:\n",
    "                ax.plot(t_eval, chance_bound, color='orange', linestyle='--',\n",
    "                         linewidth=1.5, label='95% Chance Bound')\n",
    "        ax.legend()\n",
    "\n",
    "    axs[2, 0].step(t_u, Tj_traj, where='post', color='c', linewidth=2)\n",
    "    axs[2, 0].set_title('Control Tj [K]')\n",
    "    axs[2, 0].set_ylim(270, 380)\n",
    "    axs[2, 0].grid(True)\n",
    "    axs[2, 0].set_xlabel('Time [s]')\n",
    "\n",
    "    axs[2, 1].step(t_u, T0_traj, where='post', color='orange', linewidth=2)\n",
    "    axs[2, 1].set_title('Control T0 [K]')\n",
    "    axs[2, 1].set_ylim(270, 380)\n",
    "    axs[2, 1].grid(True)\n",
    "    axs[2, 1].set_xlabel('Time [s]')\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  },
